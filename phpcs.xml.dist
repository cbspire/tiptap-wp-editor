<?xml version="1.0"?>
<ruleset name="TipTap Editor">
  <description>PHP CodeSniffer ruleset for TipTap Editor plugin.</description>

  <file>includes/</file>
  <file>tiptap-editor.php</file>
  <file>uninstall.php</file>

  <arg name="basepath" value="."/>
  <arg name="colors"/>
  <arg name="extensions" value="php"/>
  <arg value="sp"/>

  <rule ref="WordPress">
    <!-- Allow short ternary operator -->
    <exclude name="WordPress.PHP.DisallowShortTernary"/>
  </rule>

  <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
    <properties>
      <property name="prefixes" type="array" value="tiptap_editor,Tiptap_Editor,TIPTAP_EDITOR"/>
    </properties>
  </rule>

  <rule ref="WordPress.WP.I18n">
    <properties>
      <property name="text_domain" type="array" value="tiptap-editor"/>
    </properties>
  </rule>
</ruleset>
